# ─────────────────────────────────────────────────────────────
# Alfa AI Studio — environment configuration
# Copy to .env.local and adjust. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Which video provider to use: "mock" (default, free, no network) or "byteplus".
# Real generation ONLY happens when this is explicitly set to "byteplus".
VIDEO_PROVIDER=mock

# BytePlus ModelArk API key (server-side only, never sent to the browser).
ARK_API_KEY=

# ModelArk API base URL (must be https).
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Default Seedance model ID (or an endpoint ID) used for generation.
ARK_MODEL=seedance-1-5-pro-251215

# Optional: extra model IDs to expose in the model picker, comma-separated.
# Each must be activated in your ModelArk console before use in byteplus mode.
# ARK_EXTRA_MODELS=seedance-1-0-pro-250528,seedance-1-0-pro-fast-251015

# Optional: timeout for each BytePlus HTTP request in milliseconds (default 30000).
# ARK_REQUEST_TIMEOUT_MS=30000

# Optional: MongoDB connection string for generation history.
# Leave empty to use local JSON files under DATA_DIR.
MONGODB_URI=

# Optional: where local development data lives (default ./.data).
# DATA_DIR=.data

# Optional: mock timings in milliseconds (queued phase, running phase).
# MOCK_QUEUE_MS=3000
# MOCK_RUN_MS=9000
